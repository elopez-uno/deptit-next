# Dockerignore ESPECIFICO de Docker/Dockerfile.backend (toma precedencia sobre el .dockerignore
# del contexto). Contexto = esta carpeta (Docker/): las rutas son relativas a Docker/.
# El build del backend SOLO necesita backend/ y migration/: todo lo demas no viaja al daemon.

# Control de versiones y meta
.git
.gitignore
.gitattributes

# El resto de la app (esta imagen es solo backend) y lo que no se usa en la imagen
frontend
docs
ops

# Recursos que se montan en runtime (o no aplican al build): NUNCA al daemon.
# env/ incluye los secretos reales (db.env/backend.env/ops.env) y certs/ las claves TLS.
db
proxy
certs
env

# Secretos y entorno (en el contenedor la configuracion la inyecta compose / env_file, nunca un .env)
**/.env
**/.env.*
**/.pgpass
**/pgpass.conf
**/*.pem
**/*.key
**/*.generated.sql

# Artefactos y datos locales del desarrollo
storage
dist
var
reference_fix02
docs/audit
ops/run
ops/logs

# Python
**/__pycache__
**/*.py[cod]
**/.venv
**/venv

# Node (por si quedo un node_modules de desarrollo local en el contexto)
**/node_modules
