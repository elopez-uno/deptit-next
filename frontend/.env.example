# DEPTIT NEXT frontend — plantilla (6A-B1). Copiar a .env.local en desarrollo. Todas las variables son SERVER-ONLY:
# no existe ninguna NEXT_PUBLIC_* (ningún valor de configuración llega al navegador).

# URL interna de FastAPI (loopback). Default: http://127.0.0.1:8001
DEPTIT_BACKEND_URL=http://127.0.0.1:8001

# Reverse proxies confiables DELANTE de Next.js que agregan/sobrescriben X-Forwarded-For (6A-B4: normalmente 1).
# 0 (default) = no se deriva la IP del cliente: Next 16 conserva el X-Forwarded-For del navegador y sería falsificable.
#DEPTIT_TRUSTED_PROXY_HOPS=0

# next start: escuchar solo en loopback (el reverse proxy es el único servicio público)
#HOSTNAME=127.0.0.1
#PORT=3000
