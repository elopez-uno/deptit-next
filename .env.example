# DEPTIT NEXT - variables de INFRAESTRUCTURA del stack Docker.  NO contienen secretos.
#
# Copiar y ajustar por servidor:   cp Docker/.env.example Docker/.env
#
# Los SECRETOS (db.env / backend.env / ops.env) van en Docker/env/, JUNTO a estas plantillas:
# DENTRO del proyecto pero NUNCA en git (.gitignore los excluye y los dockerignore los sacan del
# contexto de build, asi tampoco viajan al daemon ni a ninguna imagen).
# Plantillas: Docker/env/*.example.  Ver Docker/README.md §2.2.
#
# Este archivo lo lee Docker Compose (junto a compose.yaml); no se hornea en ninguna imagen.

# --- Entorno del despliegue ---------------------------------------------------------------------
# Directorio de los archivos de secretos.  Default ./env (dentro del proyecto, relativo a esta
# carpeta).  Si se prefiere sacarlos del arbol del proyecto: DEPTIT_ENV_DIR=/etc/deptit-next.
DEPTIT_ENV_DIR=./env
# desarrollo | produccion.  El stack NO admite preproduccion (para eso esta ops/preprod).
# El init de la base exige: desarrollo -> deptit_next_dev / deptit_next_app
#                           produccion -> deptit_next_prod / un rol propio (nunca deptit_next_app)
DEPTIT_ENTORNO=desarrollo
DEPTIT_DB_NAME=deptit_next_dev

# --- Imagenes -----------------------------------------------------------------------------------
# Etiqueta local de las imagenes construidas en el servidor (fecha, commit...).  Facilita rollback:
# las imagenes viejas quedan en el host y se puede volver a etiquetar el commit anterior.
DEPTIT_IMAGE_TAG=local

# --- Red interna --------------------------------------------------------------------------------
# Subnet privada del stack.  Si se cambia, los servicios conservan las IPs de abajo: mantenerlas
# dentro de la subnet y regenerar los certificados del db si cambia DEPTIT_DB_IP (SAN).
# DEPTIT_FRONTEND_IP es la que confía el backend para aceptar x-deptit-client-ip.
DEPTIT_SUBNET=172.28.0.0/24
DEPTIT_DB_IP=172.28.0.2
DEPTIT_BACKEND_IP=172.28.0.3
DEPTIT_FRONTEND_IP=172.28.0.4
DEPTIT_PROXY_IP=172.28.0.5

# --- Frontend (BFF) -----------------------------------------------------------------------------
# FastAPI por la red interna (nunca se publica al host).
DEPTIT_BACKEND_URL=http://backend:8001
# 1 = hay un proxy de confianza (Caddy) delante de Next.js: el BFF toma la IP real del cliente de la
# ultima entrada del X-Forwarded-For.  0 solo sin proxy (se pierde el limite de login por IP).
DEPTIT_TRUSTED_PROXY_HOPS=1
# Zona horaria institucional para fechas SSR del frontend y para el backend (settings.apply_timezone).
DEPTIT_TIMEZONE=America/Argentina/Buenos_Aires

# --- Proxy (unico servicio publico) -------------------------------------------------------------
# Puertos publicados en el host (el 80 solo redirige a HTTPS en produccion).
DEPTIT_HTTP_PORT=80
DEPTIT_HTTPS_PORT=443
# desarrollo       -> Caddyfile.desarrollo        (HTTP plano; servidor de desarrollo)
# produccion       -> Caddyfile.produccion        (HTTPS con certificado institucional en Docker/certs/proxy/)
# produccion-acme  -> Caddyfile.produccion-acme   (HTTPS con ACME: requiere dominio publico y salida a Internet)
DEPTIT_PROXY_MODE=desarrollo
# Dominio publico de produccion (obligatorio en produccion y produccion-acme; vacio = Caddy no arranca).
DEPTIT_PROXY_DOMAIN=
# Correo del responsable para ACME (solo produccion-acme).
DEPTIT_ACME_EMAIL=
