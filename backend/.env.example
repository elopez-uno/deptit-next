# DEPTIT NEXT backend — plantilla de configuración (6A-B1). Copiar a .env (solo desarrollo local) y completar.
# .env NUNCA se versiona ni viaja en un artefacto; en preproducción/producción las variables las provee el servicio
# (archivo de entorno 0600 fuera del repositorio, 6A-B2). Especificación: docs/ETAPA6_6AB1_PRODUCTIVE_SOFTWARE_HARDENING.md

# --- Runtime -------------------------------------------------------------------------------------------------------
# Obligatoria, sin default: desarrollo | preproduccion | produccion
DEPTIT_ENTORNO=desarrollo
# Zona horaria del proceso (IANA). Default: America/Argentina/Buenos_Aires
#DEPTIT_TIMEZONE=America/Argentina/Buenos_Aires
# Zona de la sesión PostgreSQL (CURRENT_DATE / CURRENT_TIMESTAMP). Default: UTC (comportamiento certificado)
#DEPTIT_DB_TIMEZONE=UTC
# Bind de uvicorn (serve.py). Debe ser loopback salvo DEPTIT_BACKEND_ALLOW_NON_LOOPBACK=1 (red privada)
#DEPTIT_BACKEND_HOST=127.0.0.1
#DEPTIT_BACKEND_PORT=8001

# --- Base de datos (DEPTIT_DB_* o, alternativamente, DATABASE_URL; nunca ambas) --------------------------------------
# Base permitida por entorno: desarrollo=deptit_next_dev, preproduccion=deptit_next_preprod, produccion=deptit_next_prod
# La base deptit (sistema local actual) está PROHIBIDA en todos los entornos.
DEPTIT_DB_HOST=127.0.0.1
DEPTIT_DB_PORT=5432
DEPTIT_DB_NAME=deptit_next_dev
DEPTIT_DB_USER=deptit_next_app
# SECRETO: nunca en el repositorio. (Alternativa: dejarla vacía y usar un pgpass del usuario del servicio.)
DEPTIT_DB_PASSWORD=
# Obligatoria fuera de desarrollo; una base remota exige require / verify-ca / verify-full
DEPTIT_DB_SSLMODE=prefer
# Confirmación explícita de la guarda (deben coincidir con la conexión y con el entorno)
DEPTIT_EXPECTED_DATABASE=deptit_next_dev
DEPTIT_EXPECTED_DB_USER=deptit_next_app

# --- Seguridad --------------------------------------------------------------------------------------------------------
# Cookie Secure: default 0 en desarrollo, 1 fuera; 0 fuera de desarrollo impide arrancar
#DEPTIT_SESSION_COOKIE_SECURE=0
# Swagger / ReDoc / OpenAPI: default 1 en desarrollo; 1 fuera de desarrollo impide arrancar
#DEPTIT_API_DOCS=1
# Sesión y límite por cuenta (contrato B12G): minutos / horas / intentos
#DEPTIT_SESSION_IDLE_TIMEOUT_MINUTES=30
#DEPTIT_SESSION_ABSOLUTE_HOURS=8
#DEPTIT_LOGIN_MAX_FAILED_ATTEMPTS=5
#DEPTIT_LOGIN_FAILURE_WINDOW_MINUTES=15
#DEPTIT_LOGIN_LOCKOUT_MINUTES=15
# Límite por origen (IP confiable enviada por Next.js; ver DEPTIT_TRUSTED_PROXY_HOPS en el frontend)
#DEPTIT_LOGIN_IP_MAX_FAILED_ATTEMPTS=20
#DEPTIT_LOGIN_IP_FAILURE_WINDOW_MINUTES=15
#DEPTIT_LOGIN_IP_LOCKOUT_MINUTES=15
# IPs desde las que FastAPI acepta x-deptit-client-ip (el proceso Next.js). Default: 127.0.0.1,::1
#DEPTIT_TRUSTED_FRONTEND_IPS=127.0.0.1,::1

# --- Storage ------------------------------------------------------------------------------------------------------------
# Raíz documental persistente (Word de Disposiciones y plantillas). Desarrollo: default <repo>/storage/documents.
# Fuera de desarrollo: obligatoria, absoluta, existente, con permisos; nunca dentro del código ni de árboles protegidos.
#DEPTIT_DOCUMENTS_DIR=
# Raíces adicionales prohibidas (separadas por ; en Windows o : en Linux)
#DEPTIT_FORBIDDEN_DIRS=

# --- Backups y gate de Crear período (D-E4-04; herramientas de 6A-B2: python -m operacion, docs/RUNBOOK_DEPTIT_NEXT.md)
# Gate: activo por defecto; "desactivado" solo en desarrollo (fuera de desarrollo el backend no arranca).
#DEPTIT_BACKUP_GATE_CREAR_PERIODO=activo
# Directorio de backups (base + documents/ + sets/): absoluto, fuera del código, de .git y de la raíz documental.
# Lo leen el gate (evidencia del backup) y las herramientas operativas. Obligatorio para el gate fuera de desarrollo.
#DEPTIT_BACKUP_DIR=
# Antigüedad máxima del backup verificado que exige Crear período (1..168).
#DEPTIT_CRITICAL_BACKUP_MAX_AGE_HOURS=24

# --- SOLO herramientas operativas (archivo aparte: backend/.env.ops en desarrollo; ops.env del servidor) -------------
# La aplicación NUNCA carga estas credenciales.  Rol de solo lectura para pg_dump:
#DEPTIT_BACKUP_DB_USER=
#DEPTIT_BACKUP_DB_PASSWORD=
# Rol de restore: CREATEDB para restore drills (deptit_next_restore_test_*), u owner de la base en una recuperación.
#DEPTIT_RESTORE_DB_USER=
#DEPTIT_RESTORE_DB_PASSWORD=
# Binarios de PostgreSQL si no están en PATH (pg_dump, pg_restore, psql, createdb, dropdb).
#DEPTIT_PG_BIN_DIR=
# Retención (sin default: obligatoria para "retention"); nunca se borra lo más nuevo que MIN_HOURS (default 48).
#DEPTIT_BACKUP_RETENTION_DAYS=14
#DEPTIT_BACKUP_RETENTION_MIN_HOURS=48
