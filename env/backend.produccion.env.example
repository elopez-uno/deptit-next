# DEPTIT NEXT - entorno del BACKEND en el servidor PRODUCTIVO.  Copiar en ESTA carpeta (gitignored):
#   cp Docker/env/backend.produccion.env.example Docker/env/backend.env && chmod 600 Docker/env/backend.env
#
# Lo leen los contenedores `backend` y `ops`.  Validacion completa al arrancar (fail-closed).
#
# En Docker/.env (servidor productivo) debe estar:
#   DEPTIT_ENTORNO=produccion
#   DEPTIT_DB_NAME=deptit_next_prod
#   DEPTIT_PROXY_MODE=produccion  (o produccion-acme)
#   DEPTIT_PROXY_DOMAIN=<dominio publico>
#
# COINCIDENCIAS OBLIGATORIAS con Docker/env/db.env: DEPTIT_DB_USER/DEPTIT_DB_PASSWORD deben
# ser el MISMO rol y la MISMA contrasena que DEPTIT_APP_DB_USER/DEPTIT_APP_DB_PASSWORD.
# En produccion el rol es PROPIO (nunca deptit_next_app, que es el rol de desarrollo).

# --- Runtime ------------------------------------------------------------------------------------
DEPTIT_TIMEZONE=America/Argentina/Buenos_Aires
DEPTIT_BACKEND_HOST=0.0.0.0
DEPTIT_BACKEND_ALLOW_NON_LOOPBACK=1
DEPTIT_BACKEND_PORT=8001

# --- Base de datos ------------------------------------------------------------------------------
DEPTIT_DB_HOST=db
DEPTIT_DB_PORT=5432
DEPTIT_DB_USER=deptit_next_prod_app
# SECRETO.  >= 48 caracteres (openssl rand -base64 48).
DEPTIT_DB_PASSWORD=
# Produccion: verificacion del certificado del servidor (CA propia del stack, generada con
# Docker/certs/generar-certificados-db.sh y montada en /etc/deptit-next/db-tls).
DEPTIT_DB_SSLMODE=verify-full
PGSSLROOTCERT=/etc/deptit-next/db-tls/ca.crt
# Si el operador prefiere solo cifrado (sin verificar el certificado), usar require y quitar la CA.
#DEPTIT_DB_SSLMODE=require
DEPTIT_EXPECTED_DATABASE=deptit_next_prod
DEPTIT_EXPECTED_DB_USER=deptit_next_prod_app

# --- Seguridad ----------------------------------------------------------------------------------
# Defaults de produccion: cookie Secure (HTTPS termina en el proxy), sin Swagger/ReDoc/OpenAPI.
#DEPTIT_SESSION_COOKIE_SECURE=1
#DEPTIT_API_DOCS=0
# Limites de sesion y de login (defaults certificados; ajustar solo con aprobacion).
#DEPTIT_SESSION_IDLE_TIMEOUT_MINUTES=30
#DEPTIT_SESSION_ABSOLUTE_HOURS=8
#DEPTIT_LOGIN_MAX_FAILED_ATTEMPTS=5
#DEPTIT_LOGIN_FAILURE_WINDOW_MINUTES=15
#DEPTIT_LOGIN_LOCKOUT_MINUTES=15
#DEPTIT_LOGIN_IP_MAX_FAILED_ATTEMPTS=20
#DEPTIT_LOGIN_IP_FAILURE_WINDOW_MINUTES=15
#DEPTIT_LOGIN_IP_LOCKOUT_MINUTES=15

# --- Storage y backups --------------------------------------------------------------------------
DEPTIT_DOCUMENTS_DIR=/var/lib/deptit-next/documents
DEPTIT_BACKUP_DIR=/var/backups/deptit-next
# Fuera de desarrollo el gate NO se puede desactivar (el backend no arranca).
DEPTIT_BACKUP_GATE_CREAR_PERIODO=activo
DEPTIT_CRITICAL_BACKUP_MAX_AGE_HOURS=24
