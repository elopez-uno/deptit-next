# DEPTIT NEXT - SECRETOS del cluster PostgreSQL del stack.  Copiar en ESTA carpeta (gitignored):
#   cp Docker/env/db.env.example Docker/env/db.env && chmod 600 Docker/env/db.env
#
# Lo lee SOLO el contenedor `db` (y el script de inicializacion del primer arranque).  La aplicacion
# nunca ve estas credenciales.  NUNCA commitear este archivo (lo excluye Docker/env/.gitignore).
#
# Generar cada contrasena (>= 48 caracteres):
#   openssl rand -base64 48
#
# COINCIDENCIAS OBLIGATORIAS (una discrepancia impide arrancar, fail-closed):
#   DEPTIT_APP_DB_USER/PASSWORD     = DEPTIT_DB_USER/DEPTIT_DB_PASSWORD de Docker/env/backend.env
#   DEPTIT_BACKUP_DB_USER/PASSWORD  = Docker/env/ops.env
#   DEPTIT_RESTORE_DB_USER/PASSWORD = Docker/env/ops.env
#
# DEPTIT_ENTORNO y DEPTIT_DB_NAME NO van aqui: los inyecta compose desde Docker/.env (un solo lugar).

# Superusuario del cluster (contenerizado, solo accesible por socket dentro del contenedor).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Base de mantenimiento del cluster (el init y los restore drills de createdb/dropdb se conectan aqui).
POSTGRES_DB=postgres

# --- DESARROLLO: nombres exactos que exige settings.py -------------------------------------------
# (produccion: usar roles propios, p.ej. deptit_next_prod_app / _owner / _backup / _restore)
DEPTIT_APP_DB_USER=deptit_next_app
DEPTIT_APP_DB_PASSWORD=

# Owner de la base y de todos sus objetos.  Solo lo usa el init (crea el esquema y aplica GRANT).
# Jamas lo usa la aplicacion.
DEPTIT_OWNER_DB_USER=deptit_next_owner
DEPTIT_OWNER_DB_PASSWORD=

# Rol de solo lectura para pg_dump / pg_restore de las herramientas operativas.
DEPTIT_BACKUP_DB_USER=deptit_next_backup
DEPTIT_BACKUP_DB_PASSWORD=

# Rol de restore drills: CREATEDB y CONNECT solo a la base de mantenimiento (postgres).
DEPTIT_RESTORE_DB_USER=deptit_next_restore
DEPTIT_RESTORE_DB_PASSWORD=
