# DEPTIT NEXT - entorno del BACKEND en el servidor de DESARROLLO.  Copiar en ESTA carpeta (gitignored):
#   cp Docker/env/backend.desarrollo.env.example Docker/env/backend.env && chmod 600 Docker/env/backend.env
#
# Lo leen los contenedores `backend` y `ops`.  Las variables se validan completas al arrancar
# (settings.load): una sola invalida y el contenedor no levanta (fail-closed).
#
# NO repetir aqui DEPTIT_ENTORNO / DEPTIT_DB_NAME (los inyecta compose desde Docker/.env) ni
# DEPTIT_TRUSTED_FRONTEND_IPS (lo inyecta compose con la IP del frontend: DEPTIT_FRONTEND_IP).
# SECRETOS: DEPTIT_DB_PASSWORD debe coincidir con DEPTIT_APP_DB_PASSWORD de Docker/env/db.env.

# --- Runtime ------------------------------------------------------------------------------------
DEPTIT_TIMEZONE=America/Argentina/Buenos_Aires
# Escucha en todas las interfaces DENTRO de la red interna de compose (no hay puertos publicados).
DEPTIT_BACKEND_HOST=0.0.0.0
# Exigido por settings.py para un bind no-loopback.
DEPTIT_BACKEND_ALLOW_NON_LOOPBACK=1
DEPTIT_BACKEND_PORT=8001

# --- Base de datos ------------------------------------------------------------------------------
DEPTIT_DB_HOST=db
DEPTIT_DB_PORT=5432
DEPTIT_DB_USER=deptit_next_app
# SECRETO.  >= 48 caracteres (openssl rand -base64 48).
DEPTIT_DB_PASSWORD=
# Cifrado obligatorio: el PostgreSQL del stack arranca con ssl=on y la red Docker no es loopback.
# Endurecimiento opcional (requiere el certificado generado por Docker/certs/generar-certificados-db.sh):
#DEPTIT_DB_SSLMODE=verify-full
#PGSSLROOTCERT=/etc/deptit-next/db-tls/ca.crt
DEPTIT_DB_SSLMODE=require
# Guardas de identidad: deben coincidir con la conexion y con el entorno.
DEPTIT_EXPECTED_DATABASE=deptit_next_dev
DEPTIT_EXPECTED_DB_USER=deptit_next_app

# --- Seguridad ----------------------------------------------------------------------------------
# Defaults de desarrollo: cookie sin Secure (HTTP plano) y Swagger/ReDoc habilitados.
#DEPTIT_SESSION_COOKIE_SECURE=0
#DEPTIT_API_DOCS=1
# Limites de sesion y de login (defaults certificados; ajustar solo con aprobacion).
#DEPTIT_SESSION_IDLE_TIMEOUT_MINUTES=30
#DEPTIT_SESSION_ABSOLUTE_HOURS=8
#DEPTIT_LOGIN_MAX_FAILED_ATTEMPTS=5
#DEPTIT_LOGIN_FAILURE_WINDOW_MINUTES=15
#DEPTIT_LOGIN_LOCKOUT_MINUTES=15
#DEPTIT_LOGIN_IP_MAX_FAILED_ATTEMPTS=20
#DEPTIT_LOGIN_IP_FAILURE_WINDOW_MINUTES=15
#DEPTIT_LOGIN_IP_LOCKOUT_MINUTES=15

# --- Storage y backups --------------------------------------------------------------------------
# Volumenes del stack: los crea la imagen y los posee el usuario sin privilegios (uid 700).
DEPTIT_DOCUMENTS_DIR=/var/lib/deptit-next/documents
# El backend monta este volumen READ-ONLY: solo lee los manifests del gate (B11).
DEPTIT_BACKUP_DIR=/var/backups/deptit-next
DEPTIT_BACKUP_GATE_CREAR_PERIODO=activo
DEPTIT_CRITICAL_BACKUP_MAX_AGE_HOURS=24
