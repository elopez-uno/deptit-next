# DEPTIT NEXT - SECRETOS de las herramientas operativas.  Copiar en ESTA carpeta (gitignored):
#   cp Docker/env/ops.env.example Docker/env/ops.env && chmod 600 Docker/env/ops.env
#
# Lo lee SOLO el contenedor efimero `ops` (perfil "tools"): backup-set, verify-*, restore drills,
# retention, bootstrap-superadmin, health.  La aplicacion NUNCA carga estas credenciales.
#
# COINCIDENCIAS OBLIGATORIAS con Docker/env/db.env (mismos usuarios y contrasenas):
#   DEPTIT_BACKUP_DB_USER/PASSWORD   = DEPTIT_BACKUP_DB_USER/PASSWORD
#   DEPTIT_RESTORE_DB_USER/PASSWORD  = DEPTIT_RESTORE_DB_USER/PASSWORD
# Los roles operativos deben ser DISTINTOS del rol de la aplicacion (lo verifica operacion/config.py).

# pg_dump / lectura de verificacion (solo SELECT; sin escritura).
DEPTIT_BACKUP_DB_USER=deptit_next_backup
DEPTIT_BACKUP_DB_PASSWORD=

# Restore drills: CREATEDB y CONNECT solo a la base de mantenimiento `postgres`.
DEPTIT_RESTORE_DB_USER=deptit_next_restore
DEPTIT_RESTORE_DB_PASSWORD=

# Solo preproduccion (no se usa en este stack): siembra inicial con el owner.
#DEPTIT_OWNER_DB_USER=
#DEPTIT_OWNER_DB_PASSWORD=

# Retencion de backups: obligatoria para `retention --apply`; nunca borra lo mas nuevo que MIN_HOURS.
DEPTIT_BACKUP_RETENTION_DAYS=14
DEPTIT_BACKUP_RETENTION_MIN_HOURS=48

# Binarios de PostgreSQL: en la imagen estan en el PATH (cliente 18 del repo PGDG).
#DEPTIT_PG_BIN_DIR=
